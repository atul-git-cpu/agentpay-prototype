# Created by `npm run wallet:new` — never commit the real .env file.
# Testnet-only wallets. Fund the BUYER address at https://faucet.circle.com (Arc Testnet).
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
SELLER_ADDRESS=

# Seller API
PORT=3000
SELLER_BASE_URL=http://localhost:3000
PRICE_PER_CALL=$0.002

# Buyer guardrails
MAX_SPEND_USDC=0.05
DEPOSIT_USDC=1

# ---- Phase 2: AI agent ----
# Circle Developer Console (console.circle.com) -> API Keys -> testnet key
CIRCLE_API_KEY=
# Filled in by `npm run circle:setup` — keep these secret
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
AGENT_WALLET_ID=
AGENT_WALLET_ADDRESS=

# Model for the agent: any OpenAI-compatible chat API with tool calling.
# Default: Google Gemini (key from aistudio.google.com).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Groq backup: LLM_BASE_URL=https://api.groq.com/openai/v1/  LLM_MODEL=openai/gpt-oss-120b

# Agent guardrails (enforced in code, not left to the model)
AGENT_FUND_USDC=0.5
AGENT_BUDGET_USDC=0.02
AGENT_MAX_CALLS=10

# ---- Phase 3: ledger ----
# Neon (neon.tech) -> your project -> Connection string (starts with postgresql://)
DATABASE_URL=
# Indicative USD->INR rate used on statements only
USD_INR_RATE=95

# ---- Phase 4: marketplace + payouts (filled by `npm run sellers:setup`) ----
SELLER_US_PRIVATE_KEY=
SELLER_US_ADDRESS=
SELLER_EU_PRIVATE_KEY=
SELLER_EU_ADDRESS=
SELLER_KE_PRIVATE_KEY=
SELLER_KE_ADDRESS=
# Mock payout partners' treasury addresses (receive the real on-chain USDC leg)
PARTNER_IN_TREASURY=
PARTNER_EU_TREASURY=
PARTNER_US_TREASURY=
PARTNER_SWIFT_TREASURY=
# Indicative FX used by the mock partners
USD_EUR_RATE=0.92
